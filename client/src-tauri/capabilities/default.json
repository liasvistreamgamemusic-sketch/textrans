{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "voice-client の全ウィンドウに対する既定権限 (設定画面・辞書エディタ・オーバーレイ)",
  "windows": ["main", "voice-overlay"],
