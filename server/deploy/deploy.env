# サーバー機デプロイの設定値 (docs/design.md §1.1, §4.6, §4.8, §8.2 が正)
# setup.sh / setup-root.sh / sync.sh / gpu-peak.sh はこのファイルを source する。
# 値を変えるときはここだけを直す(スクリプト本体にハードコードしない)。
# systemd ユニット (voice-llama.service / voice-gateway.service) は %h 指定子で
# パスを自己完結させているため、このファイルを読まない。

# --- リモート(サーバー機)接続先。sync.sh が mac から使う ---
REMOTE_HOST="tomoya@192.168.11.10"
REMOTE_SSH_KEY="$HOME/.ssh/theagent_box"

# --- LAN 上のバインド先。設計 §1.1(DHCP予約済み)・§7.2(ufw許可対象) ---
LAN_IP="192.168.11.10"
LAN_SUBNET="192.168.11.0/24"
GATEWAY_PORT="8765"

# --- llama-server(ローカルのみ bind。設計 §4.1, §7.2) ---
LLAMA_HOST="127.0.0.1"
LLAMA_PORT="8081"
LLAMA_BIN="$HOME/Apps/llama.cpp/build/bin/llama-server"
LLAMA_CTX_SIZE="4096"
LLAMA_NGL="99"
# 実機確認 (2026-09-26): -fa on/off で速度差はほぼ無し(約100 tok/s)だが
# VRAM は on の方が僅かに少ない(3211MiB vs 3346MiB)。既定は on。
LLAMA_FLASH_ATTN="on"

# --- LLM モデル(設計 §6.2)。GGUF の実在は 2026-09-26 に HF API で確認済み ---
LLM_MODEL_REPO="unsloth/Qwen3.5-4B-GGUF"
LLM_MODEL_FILE="Qwen3.5-4B-Q4_K_M.gguf"

# --- ASR モデル(設計 §4.2, §6.1 初版既定) ---
ASR_MODEL_NAME="large-v3-turbo"
ASR_COMPUTE_TYPE="float16"

# --- パス(すべて sudo 不要、tomoya 所有。設計 §4.8) ---
VOICE_HOME="$HOME/voice"
APP_DIR="$VOICE_HOME/app"
CONFIG_DIR="$VOICE_HOME/config"
MODELS_DIR="$VOICE_HOME/models"
DATA_DIR="$VOICE_HOME/data"
LOGS_DIR="$VOICE_HOME/logs"
WHISPER_VENV_DIR="$MODELS_DIR/.whisper-venv"
HF_CACHE_DIR="$MODELS_DIR/hf"

# --- systemd ユーザーユニット配置先 ---
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"

# --- linger 対象ユーザー(setup-root.sh が使用。設計 §4.8) ---
LINGER_USER="tomoya"
